# Copie para .env (que NÃO vai para o git) e preencha.
# String de conexão do Postgres: painel do Supabase > Project Settings > Database > Connection string.
# Use a conexão direta ou o pooler em modo "session" (o modo "transaction" não suporta LISTEN).
# Este valor dá acesso total ao banco: só no servidor, nunca no front.
DATABASE_URL=postgresql://postgres:SENHA@db.plakfjhvtlgkyiqnfdpz.supabase.co:5432/postgres

# Intervalo entre voltas do worker, em ms (ele também acorda quando chega comando).
WORKER_INTERVAL_MS=5000
